{
  "autostart": true,
  "binary": {
    "linux": {
      "aarch64": "target/release/youtube-adapter-rs",
      "arm": "target/release/youtube-adapter-rs",
      "x86_64": "target/release/youtube-adapter-rs"
    },
    "macos": {
      "aarch64": "target/release/youtube-adapter-rs",
      "arm": "target/release/youtube-adapter-rs",
      "x86_64": "target/release/youtube-adapter-rs"
    },
    "windows": {
      "aarch64": "target/release/youtube-adapter-rs.exe",
      "arm": "target/release/youtube-adapter-rs.exe",
      "x86_64": "target/release/youtube-adapter-rs.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "capabilities": "input",
  "command_flags": [
    "--release"
  ],
  "credentials": [
    {
      "env": "",
      "key": "channel_id",
      "label": "Channel ID / Handle",
      "list": false,
      "sensitive": false
    },
    {
      "env": "YOUTUBE_API_KEY",
      "key": "api_keys",
      "label": "API Keys (one per line)",
      "list": true,
      "sensitive": true
    },
    {
      "env": "",
      "key": "unlisted_video_ids",
      "label": "Unlisted Video IDs",
      "list": true,
      "optional": true,
      "sensitive": false
    },
    {
      "env": "google_oauth_client_id",
      "key": "google_oauth_client_id",
      "label": "Google OAuth Client ID (console.cloud.google.com)",
      "list": false,
      "optional": true,
      "sensitive": true
    },
    {
      "env": "google_oauth_client_secret",
      "key": "google_oauth_client_secret",
      "label": "Google OAuth Client Secret",
      "list": false,
      "optional": true,
      "sensitive": true
    },
    {
      "env": "refresh_token",
      "key": "refresh_token",
      "label": "Google OAuth Refresh Token (optional; auto-acquired)",
      "list": false,
      "optional": true,
      "sensitive": true
    }
  ],
  "description": "a module for getting and sending messages to youtube",
  "launch_command": "cargo run",
  "name": "youtube-adapter",
  "root_file": "./src/main.rs",
  "version": "0.1.0",
  "price": 0,
  "min_rank": 0,
  "authority": 0
}